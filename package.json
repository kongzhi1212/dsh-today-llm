{
  "name": "dsh-today-llm",
  "version": "1.3.1",
  "type": "module",
  "description": "Use the models of the locally signed-in Today desktop app as a DeepSeek Harness LLM provider.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "today",
    "todayai",
    "model-provider"
  ],
  "license": "MIT",
  "author": "kongzhi1212 (https://github.com/kongzhi1212)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongzhi1212/dsh-today-llm.git"
  },
  "homepage": "https://github.com/kongzhi1212/dsh-today-llm#readme",
  "bugs": {
    "url": "https://github.com/kongzhi1212/dsh-today-llm/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
